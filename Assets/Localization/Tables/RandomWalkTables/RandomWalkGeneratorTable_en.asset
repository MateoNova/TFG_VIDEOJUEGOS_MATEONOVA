  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: RandomWalkGeneratorTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 346056fa303416e48a44cfe6ad2e0ee0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 48466137088
    m_Localized: How many times the random walk process is repeated to create the
      dungeon layout.\n\nIf you set it higher, the dungeon will have more paths and
      cover a larger area.\n\nIf you set it lower, the dungeon will have fewer paths
      and be more compact.
    m_Metadata:
      m_Items: []
  - m_Id: 35311661780992
    m_Localized: Number of corridors generated from the starting point.\n\nIf you
      set it higher, more corridors will be created, increasing connectivity.\n\nIf
      you set it lower, fewer corridors will be created, making the dungeon simpler.
    m_Metadata:
      m_Items: []
  - m_Id: 35276333158400
    m_Localized: Length of each corridor created when generating corridors.\n\nIf
      you set it higher, corridors will be longer, connecting distant areas.\n\nIf
      you set it lower, corridors will be shorter, making the dungeon more compact.
    m_Metadata:
      m_Items: []
  - m_Id: 35370461728768
    m_Localized: Width of the corridors connecting rooms.\n\nIf you set it higher,
      corridors will be wider, making movement easier but using more space.\n\nIf
      you set it lower, corridors will be narrower, making the dungeon feel tighter.
    m_Metadata:
      m_Items: []
  - m_Id: 35179767697408
    m_Localized: Enables the creation of structured corridors and rooms in the dungeon.\n\nIf
      enabled, the dungeon will have corridors connecting rooms, making navigation
      clearer.\n\nIf disabled, the dungeon will be a more open, random area without
      defined corridors.
    m_Metadata:
      m_Items: []
  - m_Id: 35344415100928
    m_Localized: Percentage of possible room locations that will actually become
      rooms.\n\nIf you set it higher, more rooms will be created, making the dungeon
      feel fuller.\n\nIf you set it lower, fewer rooms will appear, making the dungeon
      more focused on corridors.
    m_Metadata:
      m_Items: []
  - m_Id: 59815934988288
    m_Localized: Number of steps taken in each random walk iteration.\n\nIf you set
      it higher, each path will be longer, making the dungeon more spread out.\n\nIf
      you set it lower, each path will be shorter, resulting in a denser dungeon.
    m_Metadata:
      m_Items: []
  - m_Id: 15299550643130368
    m_Localized: Path Wanderer
    m_Metadata:
      m_Items: []
  - m_Id: 15601481949286400
    m_Localized: Iteracions de passeig
    m_Metadata:
      m_Items: []
  - m_Id: 15601661297725440
    m_Localized: Steps per Iteration
    m_Metadata:
      m_Items: []
  - m_Id: 15601685096206336
    m_Localized: Generate Corridors
    m_Metadata:
      m_Items: []
  - m_Id: 15601717165854720
    m_Localized: Corridor Length
    m_Metadata:
      m_Items: []
  - m_Id: 15601736908443648
    m_Localized: Corridor Count
    m_Metadata:
      m_Items: []
  - m_Id: 15601756848164864
