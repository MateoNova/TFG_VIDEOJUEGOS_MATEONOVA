  m_SharedData: {fileID: 11400000, guid: 346056fa303416e48a44cfe6ad2e0ee0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 48466137088
    m_Localized: "Cu\xE1ntas veces se repite el proceso de caminata aleatoria para
      crear el dise\xF1o de la mazmorra.\\n\\nSi lo aumentas, la mazmorra tendr\xE1
      m\xE1s caminos y cubrir\xE1 un \xE1rea mayor.\\n\\nSi lo disminuyes, la mazmorra
      tendr\xE1 menos caminos y ser\xE1 m\xE1s compacta."
    m_Metadata:
      m_Items: []
  - m_Id: 35344415100928
    m_Localized: "Porcentaje de ubicaciones posibles que realmente se convertir\xE1n
      en habitaciones.\\n\\nSi lo aumentas, se crear\xE1n m\xE1s habitaciones y la
      mazmorra estar\xE1 m\xE1s llena.\\n\\nSi lo disminuyes, aparecer\xE1n menos
      habitaciones y la mazmorra se centrar\xE1 m\xE1s en los pasillos."
    m_Metadata:
      m_Items: []
  - m_Id: 35179767697408
    m_Localized: "Activa la creaci\xF3n de pasillos estructurados y habitaciones
      en la mazmorra.\\n\\nSi est\xE1 activado, la mazmorra tendr\xE1 pasillos que
      conectan habitaciones, facilitando la navegaci\xF3n.\\n\\nSi est\xE1 desactivado,
      la mazmorra ser\xE1 un \xE1rea m\xE1s abierta y aleatoria sin pasillos definidos."
    m_Metadata:
      m_Items: []
  - m_Id: 35370461728768
    m_Localized: "Ancho de los pasillos que conectan las habitaciones.\\n\\nSi lo
      aumentas, los pasillos ser\xE1n m\xE1s anchos, facilitando el movimiento pero
      ocupando m\xE1s espacio.\\n\\nSi lo disminuyes, los pasillos ser\xE1n m\xE1s
      estrechos, haciendo que la mazmorra se sienta m\xE1s ajustada."
    m_Metadata:
      m_Items: []
  - m_Id: 35276333158400
    m_Localized: "Longitud de cada pasillo creado al generar pasillos.\\n\\nSi lo
      aumentas, los pasillos ser\xE1n m\xE1s largos y conectar\xE1n \xE1reas m\xE1s
      distantes.\\n\\nSi lo disminuyes, los pasillos ser\xE1n m\xE1s cortos y la
      mazmorra ser\xE1 m\xE1s compacta."
    m_Metadata:
      m_Items: []
  - m_Id: 35311661780992
    m_Localized: "N\xFAmero de pasillos generados desde el punto de inicio.\\n\\nSi
      lo aumentas, se crear\xE1n m\xE1s pasillos, aumentando la conectividad.\\n\\nSi
      lo disminuyes, se crear\xE1n menos pasillos, haciendo la mazmorra m\xE1s simple."
    m_Metadata:
      m_Items: []
  - m_Id: 59815934988288
    m_Localized: "N\xFAmero de pasos que se dan en cada iteraci\xF3n de la caminata
      aleatoria.\\n\\nSi lo aumentas, cada camino ser\xE1 m\xE1s largo y la mazmorra
      estar\xE1 m\xE1s dispersa.\\n\\nSi lo disminuyes, cada camino ser\xE1 m\xE1s
      corto y la mazmorra ser\xE1 m\xE1s densa. "
    m_Metadata:
      m_Items: []
  - m_Id: 15299550643130368
    m_Localized: Caminante Aleatorio
    m_Metadata:
      m_Items: []
  - m_Id: 15601481949286400
    m_Localized: Iteraciones de paseo
    m_Metadata:
      m_Items: []
